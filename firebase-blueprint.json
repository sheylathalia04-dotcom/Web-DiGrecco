{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Registered fans and clients authenticated via Google Firebase Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User full name" },
        "email": { "type": "string", "description": "User email address" },
        "photoURL": { "type": "string", "description": "User avatar photo URL" },
        "favoriteSongs": { "type": "array", "items": { "type": "string" }, "description": "Array of favorite Di Grecco song IDs" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "displayName", "email"]
    },
    "fanMessages": {
      "title": "Fan Messages",
      "description": "Public guestbook messages and fan reviews for Di Grecco",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "userId": { "type": "string", "description": "Author UID" },
        "userName": { "type": "string", "description": "Author display name" },
        "userPhoto": { "type": "string", "description": "Author avatar URL" },
        "message": { "type": "string", "description": "Message text" },
        "favoriteSong": { "type": "string", "description": "Mentioned song title" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "userId", "userName", "message", "createdAt"]
    },
    "debutanteQuotes": {
      "title": "Debutante Show Quote",
      "description": "Saved 15-year celebration show quote requests",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Quote ID" },
        "userId": { "type": "string", "description": "Client UID" },
        "debutanteName": { "type": "string", "description": "Name of the 15-year-old debutante" },
        "eventDate": { "type": "string", "description": "Target date of celebration" },
        "city": { "type": "string", "description": "City and State" },
        "packageType": { "type": "string", "description": "Selected show package" },
        "estimatedGuests": { "type": "number", "description": "Estimated guest count" },
        "specialSong": { "type": "string", "description": "Chosen song for waltz or dance break" },
        "notes": { "type": "string", "description": "Special requests or choreography notes" },
        "phone": { "type": "string", "description": "WhatsApp contact number" },
        "status": { "type": "string", "description": "Status: pending, contacted, confirmed" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "userId", "debutanteName", "city", "packageType", "createdAt"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /users/{userId} {\n      allow read: if true;\n      allow write: if request.auth != null && request.auth.uid == userId;\n    }\n    match /fanMessages/{messageId} {\n      allow read: if true;\n      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;\n      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;\n    }\n    match /debutanteQuotes/{quoteId} {\n      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid) && request.resource.data.userId == request.auth.uid;\n    }\n  }\n}"
}
